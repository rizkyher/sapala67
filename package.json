		"embla-carousel-svelte": "^8.3.0",
		"lenis": "^1.3.26",
		"lucide-svelte": "^0.460.0",
		"sveltekit-superforms": "^2.30.1",
		"tailwind-merge": "^2.5.0",
		"zod": "^4.4.3"
	}
