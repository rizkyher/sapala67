{
	"name": "sapala-67",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"db:migrate:local": "wrangler d1 migrations apply sapala67 --local",
		"db:migrate": "wrangler d1 migrations apply sapala67 --remote",
		"cf:dev": "wrangler pages dev",
		"deploy:pages": "wrangler pages deploy .svelte-kit/cloudflare --project-name sapala67 --branch main",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint ."
	},
	"type": "module",
	"devDependencies": {
		"@sveltejs/adapter-cloudflare": "^4.7.0",
		"@sveltejs/adapter-static": "^3.0.0",
